generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  queued
  waiting_for_agent
  pr_opened
  waiting_for_checks
  waiting_for_preview_deploy
  preview_deployed
  waiting_for_merge
  waiting_for_production_deploy
  production_deployed
  completed
  failed
  cancelled
}

enum AuthorType {
  human
  autoapp
  cursor
  github
  vercel
  unknown
}

enum MemoryClassification {
  human_instruction
  human_approval
  human_rejection
  cursor_update
  github_update
  vercel_update
  autoapp_log
  general_noise
  unknown
}

enum DecisionType {
  merge_recommended
  cancelled
}

enum IntegrationSource {
  slack
  cursor
  github
  vercel
  autoapp
}

model Task {
  id                  String             @id @default(cuid())
  status              TaskStatus         @default(queued)
  request             String
  acceptanceCriteria  String
  forbiddenAreas      String
  slackRootTs         String?
  cursorAgentId       String?
  cursorRunId         String?
  cursorAgentUrl      String?
  githubPrUrl         String?
  vercelPreviewUrl    String?
  vercelProductionUrl String?
  resultSummary       String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  decisions           Decision[]
  memories            SlackMemory[]
  events              IntegrationEvent[]
}

model SlackMemory {
  id                     String               @id @default(cuid())
  channelId              String
  messageTs              String
  threadTs               String?
  authorId               String
  authorType             AuthorType           @default(unknown)
  rawText                String
  normalizedText         String
  classification         MemoryClassification @default(unknown)
  importance             Int                  @default(0)
  relatedTaskId          String?
  relatedTask            Task?                @relation(fields: [relatedTaskId], references: [id])
  extractedPrUrl         String?
  extractedDeploymentUrl String?
  extractedTaskCode      String?
  createdAt              DateTime             @default(now())

  @@unique([channelId, messageTs])
  @@index([channelId, createdAt])
  @@index([classification, createdAt])
}

model Decision {
  id                   String       @id @default(cuid())
  taskId               String
  task                 Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  decision             DecisionType
  decidedBySlackUserId String
  rationale            String?
  slackMessageTs       String?
  createdAt            DateTime     @default(now())
}

model IntegrationEvent {
  id            String            @id @default(cuid())
  source        IntegrationSource
  eventType     String
  payload       Json
  relatedTaskId String?
  relatedTask   Task?             @relation(fields: [relatedTaskId], references: [id])
  createdAt     DateTime          @default(now())

  @@index([source, eventType, createdAt])
}

model LaunchSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("landing_page")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
