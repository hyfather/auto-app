DATABASE_URL="postgresql://USER:PASSWORD@HOST/autoapp?sslmode=require"
OPENAI_API_KEY=""
# Optional OpenAI-compatible base URL for local tests or compatible providers.
OPENAI_API_BASE_URL=""
OPENAI_SLACK_INTENT_MODEL="gpt-4o-mini"
OPENAI_SLACK_ANSWER_MODEL="gpt-4o-mini"
SLACK_BOT_TOKEN="xoxb-"
SLACK_SIGNING_SECRET=""
SLACK_APP_TOKEN="xapp-"
SLACK_GENERAL_CHANNEL_ID="C0123456789"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTOAPP_BOT_USER_ID=""
CURSOR_BOT_USER_ID=""
VERCEL_BOT_USER_ID=""
GITHUB_BOT_USER_ID=""

# Cursor Cloud Agents — the implementation worker. AutoApp launches a cloud
# agent through the Cursor API with autoCreatePR enabled to implement each approved change and open a PR.
# Docs: https://cursor.com/docs/cloud-agent/api/endpoints
CURSOR_API_KEY=""
# GitHub repository the cloud agent should work on, e.g. https://github.com/your-org/your-repo
CURSOR_AGENT_REPO_URL=""
# Branch or commit the agent starts from (defaults to "main").
CURSOR_AGENT_STARTING_REF="main"
# Optional explicit model id from GET https://api.cursor.com/v1/models (omit to use your default).
CURSOR_AGENT_MODEL=""
# Optional override of the API base URL (defaults to https://api.cursor.com).
CURSOR_API_BASE_URL=""

# GitHub REST API access for PR discovery, status polling, and direct merge.
# Token needs repo pull-request read/write permission, plus checks/status read.
GITHUB_TOKEN=""
# Repository to watch/merge, e.g. your-org/your-repo. Defaults to CURSOR_AGENT_REPO_URL if omitted.
GITHUB_REPOSITORY=""
# Optional: merge, squash, or rebase. Defaults to squash.
GITHUB_MERGE_METHOD="squash"
# Optional: set to false only if you intentionally allow merging with no reported checks.
GITHUB_MERGE_REQUIRE_CHECKS="true"
# Optional: narrow fallback PR discovery to the GitHub login that opens Cursor PRs.
GITHUB_CURSOR_AUTHOR_LOGIN=""
# Optional GitHub Enterprise API base URL.
GITHUB_API_BASE_URL=""

# Optional future extension only.
VERCEL_TOKEN=""
