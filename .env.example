DATABASE_URL="postgresql://USER:PASSWORD@HOST/autoapp?sslmode=require"
OPENAI_API_KEY=""
SLACK_BOT_TOKEN="xoxb-"
SLACK_SIGNING_SECRET=""
SLACK_APP_TOKEN="xapp-"
SLACK_GENERAL_CHANNEL_ID="C0123456789"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTOAPP_BOT_USER_ID=""
VERCEL_BOT_USER_ID=""
GITHUB_BOT_USER_ID=""

# Cursor Cloud Agents — the implementation worker. AutoApp launches a cloud
# agent through the Cursor API to implement each approved change and open a PR.
# Docs: https://cursor.com/docs/cloud-agent/api/endpoints
CURSOR_API_KEY=""
# GitHub repository the cloud agent should work on, e.g. https://github.com/your-org/your-repo
CURSOR_AGENT_REPO_URL=""
# Branch or commit the agent starts from (defaults to "main").
CURSOR_AGENT_STARTING_REF="main"
# Optional explicit model id from GET https://api.cursor.com/v1/models (omit to use your default).
CURSOR_AGENT_MODEL=""
# Optional override of the API base URL (defaults to https://api.cursor.com).
CURSOR_API_BASE_URL=""

# Optional future extension only.
GITHUB_TOKEN=""
VERCEL_TOKEN=""
